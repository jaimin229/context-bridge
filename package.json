{
  "name": "contextbridge",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop app for structured AI coding handoffs",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretypecheck": "npm run build --workspace @contextbridge/core",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "dev": "node scripts/dev.mjs",
    "prebuild": "npm run build --workspace @contextbridge/core",
    "build": "npm run build --workspace @contextbridge/desktop",
    "package:dir": "npm run build && npm run package:dir --workspace @contextbridge/desktop",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "package:installer": "npm run build && npm run package --workspace @contextbridge/desktop"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
